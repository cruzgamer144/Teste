generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AlertChannel {
  EMAIL
  PUSH
  SMS
}

enum MatchRuleType {
  BRAND
  CATEGORY
  KEYWORD
  SIZE
}

enum SourceType {
  RSS
  API
  SCRAPER
}

enum DispatchStatus {
  SENT
  ERROR
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  preference        Preference?
  matchRules        MatchRule[]
  alertSubscription AlertSubscription?
  dispatchLogs      DispatchLog[]
  sources           Source[] @relation("SourceOwner")
  pushSubscriptions PushSubscription[]
  adminProfile      AdminUser?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Preference {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories String[]
  brands     String[]
  sizes      String[]
  keywords   String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  brand       String
  category    String
  price       Float
  currency    String
  color       String?
  sizeRange   String?
  imageUrl    String?
  productUrl  String
  store       String
  releaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  visible     Boolean  @default(true)

  dispatchLogs DispatchLog[]
}

model AlertSubscription {
  id        String        @id @default(cuid())
  userId    String        @unique
  channels  AlertChannel[]
  active    Boolean       @default(true)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model MatchRule {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   MatchRuleType
  value  String
}

model DispatchLog {
  id        String         @id @default(cuid())
  userId    String
  productId String
  channel   AlertChannel
  status    DispatchStatus
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Source {
  id        String      @id @default(cuid())
  name      String
  type      SourceType
  url       String
  enabled   Boolean     @default(true)
  ownerId   String?
  owner     User?       @relation("SourceOwner", fields: [ownerId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AdminUser {
  id     String @id @default(cuid())
  email  String @unique
  role   String @default("ADMIN")
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
